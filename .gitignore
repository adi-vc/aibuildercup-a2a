# GCP / credentials — never commit these.
# Name credential files explicitly: a blanket *.json rule silently dropped the
# golden manifest fixture and package-lock.json (see PLAN_TRACKER T4.1).
service-account*.json
gcp-credentials*.json
*-key.json
*credentials*.json

