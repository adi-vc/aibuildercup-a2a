{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vachan.dev/schemas/manifest/1.0",
  "title": "Vachan Manifest",
  "description": "The contract between Builder A (backend) and Builder B (runtime). Frozen at P2. Any change requires both builders' agreement in writing. See vachan-plan.md §28 and §64.4.",
  "type": "object",

  "required": [
    "manifest_id",
    "schema_version",
    "brain_version",
    "bitgraph_version",
    "locales",
    "beats",
    "edges",
    "slots",
    "bindings",
    "vault",
    "accessibility",
    "policy",
    "integrity"
  ],

  "additionalProperties": true,

  "properties": {

    "manifest_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable, unique identifier for this manifest version."
    },

    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Pinned schema version. Must be '1.0'. Bump only with both builders' agreement."
    },

    "brain_version": {
      "type": "string",
      "minLength": 1
    },

    "bitgraph_version": {
      "type": "string",
      "minLength": 1
    },

    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}-[A-Z]{2}$",
        "description": "BCP-47 locale tag, e.g. en-IN, hi-IN, kn-IN."
      }
    },

    "beats": {
      "type": "array",
      "items": { "$ref": "#/$defs/Beat" }
    },

    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/Edge" }
    },

    "slots": {
      "type": "array",
      "items": { "$ref": "#/$defs/Slot" }
    },

    "bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/Binding" }
    },

    "vault": {
      "type": "object",
      "description": "Map of vault_ref → VaultAsset. Every vault_ref cited in beats must appear here.",
      "additionalProperties": { "$ref": "#/$defs/VaultAsset" }
    },

    "accessibility": {
      "$ref": "#/$defs/Accessibility"
    },

    "policy": {
      "$ref": "#/$defs/Policy"
    },

    "integrity": {
      "$ref": "#/$defs/Integrity"
    }
  },

  "$defs": {

    "Beat": {
      "type": "object",
      "required": ["id", "kind", "fact_ids", "vault_refs", "text_slots", "audio_slots", "bindings", "hinge", "edges"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
      "kind": {
          "type": "string",
          "enum": ["hold", "transition", "ask_overlay"],
        "description": "hold = still plate + parallax; transition = generated clip; ask_overlay = inspector panel"
      },
      "mood": {
        "type": "boolean",
        "description": "True only for a non-stating beat; mood beats must cite no facts."
      },
      "branch_only": {
        "type": "boolean",
        "description": "Optional (T7, additive): the beat is reached only through an edge and is skipped by the main sequence. Must be the `to` of at least one edge (INV-17)."
      },
      "fact_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Every stating beat must cite ≥1 fact_id. Mood beats cite none and declare kind=hold with empty list."
        },
        "vault_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "text_slots": {
          "type": "object",
          "description": "Locale → display text. Must contain at least one entry.",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        },
        "audio_slots": {
          "type": "object",
          "description": "Locale → TTS asset id.",
          "additionalProperties": { "type": "string" }
        },
        "bindings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hinge": { "$ref": "#/$defs/Hinge" },
        "edges": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "Hinge": {
      "type": "object",
      "required": ["in", "out"],
      "properties": {
        "in":  { "type": "string", "minLength": 1 },
        "out": { "type": "string", "minLength": 1 }
      }
    },

    "Edge": {
      "type": "object",
      "required": ["id", "from", "to", "clip", "trigger", "reversible", "duration_s", "label"],
      "additionalProperties": true,
      "properties": {
        "id":         { "type": "string", "minLength": 1 },
        "from":       { "type": "string", "minLength": 1 },
        "to":         { "type": "string", "minLength": 1 },
        "clip":       { "type": "string" },
        "trigger": {
          "type": "string",
          "enum": ["auto", "drag_up", "click"]
        },
        "reversible": { "type": "boolean" },
        "duration_s": { "type": "number", "minimum": 0 },
        "label":      { "type": "string" }
      }
    },

    "Slot": {
      "type": "object",
      "required": ["id", "beat_id", "kind", "policy"],
      "additionalProperties": true,
      "properties": {
        "id":      { "type": "string", "minLength": 1 },
        "beat_id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["shoppable", "sponsor_card"],
          "description": "Only sponsor_card is allowed in kids_mode manifests."
        },
        "policy": { "$ref": "#/$defs/SlotPolicy" }
      }
    },

    "SlotPolicy": {
      "type": "object",
      "required": ["kids_mode", "categories_allowed", "competitor_exclusions"],
      "properties": {
        "kids_mode":             { "type": "boolean" },
        "categories_allowed":    { "type": "array", "items": { "type": "string" } },
        "competitor_exclusions": { "type": "array", "items": { "type": "string" } }
      }
    },

    "Binding": {
      "type": "object",
      "required": ["key", "resolver", "ttl_s"],
      "properties": {
        "key":      { "type": "string", "minLength": 1 },
        "resolver": { "type": "string", "minLength": 1 },
        "ttl_s":    { "type": "number", "minimum": 1 }
      }
    },

    "VaultAsset": {
      "type": "object",
      "required": ["kind", "uri", "fact_ids", "model", "seed", "bible_version"],
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["plate", "clip", "patch", "tts"]
        },
        "uri":         { "type": "string", "minLength": 1 },
        "poster_uri":  { "type": "string" },
        "depth_uri":   { "type": "string" },
        "fact_ids":    { "type": "array", "items": { "type": "string" } },
        "model":       { "type": "string" },
        "seed":        { "type": "integer" },
        "bible_version": { "type": "string" }
      }
    },

    "Accessibility": {
      "type": "object",
      "required": ["captions", "audio_description"],
      "properties": {
        "captions":           { "type": "boolean" },
        "audio_description":  { "type": "boolean" }
      }
    },

    "Policy": {
      "type": "object",
      "required": ["kids_mode", "competitor_exclusions"],
      "properties": {
        "kids_mode":             { "type": "boolean" },
        "competitor_exclusions": { "type": "array", "items": { "type": "string" } }
      }
    },

    "Integrity": {
      "type": "object",
      "required": ["fact_index", "beat_index", "asset_index", "coverage", "linted_at"],
      "properties": {
        "fact_index": {
          "type": "object",
          "description": "fact_id → span_id. Every fact_id cited by a beat must appear here.",
          "additionalProperties": { "type": "string" }
        },
        "beat_index": {
          "type": "object",
          "description": "fact_id → [beat_id, ...]. Used by the incremental rebuilder.",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "asset_index": {
          "type": "object",
          "description": "fact_id → [asset_id, ...]. Used for cache invalidation.",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of canon facts with a verified span. Must be 1.0 for a publishable manifest."
        },
        "linted_at": {
          "type": "string",
          "description": "ISO-8601 timestamp of the last successful lint run."
        },
        "facts": {
          "type": "object",
          "description": "Optional (T5a, additive): fact_id → published fact. Lets the runtime show a §24.2 rung-3 'as published' value and the inspector quote without reading the Brain. Keys must equal fact_index (INV-16).",
          "additionalProperties": { "$ref": "#/$defs/PublishedFact" }
        }
      }
    },
    "PublishedFact": {
      "type": "object",
      "required": ["value", "text", "quote", "origin"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "unit": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "quote": {
          "type": "string",
          "minLength": 1,
          "description": "The verbatim span text the fact was string-verified against."
        },
        "origin": { "type": "string", "enum": ["canon", "inferred", "imagined"] }
      }
    }
  }
}
