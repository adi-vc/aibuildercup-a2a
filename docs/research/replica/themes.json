{
 "_about": "Themes reviews.py sorts feedback into. Patterns are Python regular expressions, matched case-insensitively against the review text. kind is complaint (something users hate) or request (something users want that is missing). Edit freely: add the app category's own words (for a booking app: double booking, time zone, no-show).",
 "request_patterns": [
  "\\bi wish\\b",
  "\\bplease add\\b",
  "\\bwould be (nice|great|good|helpful)\\b",
  "\\bwould love\\b",
  "\\bneeds? (a|an|the|to|more)\\b",
  "\\bno way to\\b",
  "\\bthere'?s no (way|option)\\b",
  "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|connect|undo|delete|turn off)\\b",
  "\\b(missing|lacks|lacking)\\b",
  "\\bdoesn'?t (have|support|let|allow)\\b",
  "\\bif only\\b",
  "\\bfeature request\\b",
  "\\bwhy (can'?t|isn'?t|doesn'?t)\\b"
 ],
 "themes": [
  {
   "id": "credits_on_errors",
   "label": "Credits burned fixing the AI's own mistakes",
   "kind": "complaint",
   "patterns": [
    "credits? (are |were )?wa?s?ted",
    "(fix|correct)\\w* (their|its|the ai'?s?) (own )?mistakes",
    "(repay|pay(ing)? again|charged credits)",
    "credit (loss|usage|consumption)",
    "burn(ed|t|ing)? .{0,20}credits",
    "ran out of (credits|trys|tries)",
    "keep paying to correct"
   ]
  },
  {
   "id": "agent_ignores",
   "label": "AI agent ignores instructions or falsely confirms edits",
   "kind": "complaint",
   "patterns": [
    "(did not|doesn'?t|don'?t|not) (follow|listen)",
    "ignores? (it|my|the)",
    "told me .{0,40}(updated|completed|changed)",
    "changed the wrong",
    "does what it wants",
    "same mistakes",
    "unwanted changes",
    "keeps changing"
   ]
  },
  {
   "id": "no_preview",
   "label": "No preview before paying or generating",
   "kind": "complaint",
   "patterns": [
    "preview",
    "before (committing|paying|spending)",
    "generate[sd]? the video before",
    "head'?s up"
   ]
  },
  {
   "id": "moderation",
   "label": "Opaque moderation and rejected scripts",
   "kind": "complaint",
   "patterns": [
    "reject(ed|s)?",
    "flag(ged)?",
    "moderat",
    "block(ed)? (you|my)",
    "censor",
    "cannot be published",
    "not compliant",
    "policy violation"
   ]
  },
  {
   "id": "sync_quality",
   "label": "Lip-sync, avatar motion and uncanny output",
   "kind": "complaint",
   "patterns": [
    "lip.?sync",
    "\\bsync\\b",
    "mouth",
    "(hand|body) movements?",
    "exaggerated",
    "\\bfake\\b",
    "unnatural",
    "look(s)? made with ai",
    "shaking",
    "videogame"
   ]
  },
  {
   "id": "voice",
   "label": "Voice, pronunciation and audio consistency",
   "kind": "complaint",
   "patterns": [
    "pronounc",
    "pronunc",
    "voice (over|sync|changes|generation)",
    "voiceover",
    "sounds? (nothing )?like",
    "robotic",
    "acoustic",
    "emphasis"
   ]
  },
  {
   "id": "trust_accuracy",
   "label": "Output not accurate or trustable",
   "kind": "complaint",
   "patterns": [
    "trust",
    "inaccurate",
    "not applicable",
    "irrelevant",
    "wrong (advice|scene)",
    "accuracy",
    "nonsense?"
   ]
  },
  {
   "id": "edit_loop",
   "label": "Small edits require full re-generation",
   "kind": "complaint",
   "patterns": [
    "one scene",
    "minor (fix|correction|change)",
    "small (edit|change)",
    "render(ing)? time",
    "40 min",
    "regenerat",
    "revisions?",
    "amend"
   ]
  },
  {
   "id": "personalization",
   "label": "Personalised or per-viewer video",
   "kind": "request",
   "patterns": [
    "personali[sz]",
    "per.viewer",
    "each (viewer|customer|recipient)",
    "at scale",
    "translat",
    "languages?"
   ]
  },
  {
   "id": "embed_export",
   "label": "Export, embed and file handling",
   "kind": "complaint",
   "patterns": [
    "\\bmp4\\b",
    "embed",
    "file size",
    "download",
    "stitch"
   ]
  },
  {
   "id": "pricing",
   "label": "Price and paywalls",
   "kind": "complaint",
   "patterns": [
    "\\bexpensive\\b",
    "\\boverpriced\\b",
    "\\bpric(e|es|ey|ing)\\b",
    "\\bpaywall",
    "\\bsubscription\\b",
    "\\bper (month|seat|user)\\b",
    "\\bfree (plan|tier|version)\\b",
    "\\bupgrade to\\b",
    "\\bpremium\\b",
    "\\bnot worth\\b",
    "\\bcost(s|ly)?\\b"
   ]
  },
  {
   "id": "billing",
   "label": "Billing, cancelling and refunds",
   "kind": "complaint",
   "patterns": [
    "\\bcharged\\b",
    "\\brefund",
    "\\bcancel(l?ing|l?ed|lation)?\\b",
    "\\bauto.?renew",
    "\\bhidden (fee|charge)",
    "\\bbilling\\b",
    "\\bscam\\b",
    "\\bcredit card\\b"
   ]
  },
  {
   "id": "bugs",
   "label": "Bugs and crashes",
   "kind": "complaint",
   "patterns": [
    "\\bcrash(es|ed|ing)?\\b",
    "\\bbugs?\\b",
    "\\bbuggy\\b",
    "\\bglitch",
    "\\bfreez(e|es|ing)\\b",
    "\\bbroken\\b",
    "\\b(doesn'?t|does not|stopped) work",
    "\\bnot working\\b",
    "\\berror\\b"
   ]
  },
  {
   "id": "performance",
   "label": "Slow, laggy, heavy",
   "kind": "complaint",
   "patterns": [
    "\\bslow\\b",
    "\\blag(gy|s)?\\b",
    "\\bloading\\b",
    "\\btakes forever\\b",
    "\\bbattery\\b",
    "\\bsluggish\\b",
    "\\bheavy\\b"
   ]
  },
  {
   "id": "data",
   "label": "Sync and lost data",
   "kind": "complaint",
   "patterns": [
    "\\bsync(ing|s|ed)?\\b",
    "\\blost (my|all)\\b",
    "\\bdisappear",
    "\\bdata loss\\b",
    "\\bwiped\\b",
    "\\bbackup\\b",
    "\\bduplicat"
   ]
  },
  {
   "id": "ux",
   "label": "Confusing or clunky to use",
   "kind": "complaint",
   "patterns": [
    "\\bconfus",
    "\\bhard to (use|find|navigate|understand)\\b",
    "\\bcomplicated\\b",
    "\\bcluttered\\b",
    "\\bunintuitive\\b",
    "\\bnot intuitive\\b",
    "\\bclunky\\b",
    "\\btoo many (steps|clicks|taps)\\b",
    "\\blearning curve\\b",
    "\\bcan'?t find\\b"
   ]
  },
  {
   "id": "support",
   "label": "Support that does not answer",
   "kind": "complaint",
   "patterns": [
    "\\bcustomer (service|support)\\b",
    "\\bsupport (team|is|was)\\b",
    "\\bno (response|reply)\\b",
    "\\bnever (replied|responded|heard back)\\b",
    "\\bticket\\b",
    "\\bchat ?bot\\b"
   ]
  },
  {
   "id": "account",
   "label": "Login and account problems",
   "kind": "complaint",
   "patterns": [
    "\\blog ?in\\b",
    "\\bsign ?in\\b",
    "\\bpassword\\b",
    "\\blocked out\\b",
    "\\bverification\\b",
    "\\b2fa\\b",
    "\\bdelete (my )?account\\b"
   ]
  },
  {
   "id": "notifications",
   "label": "Notifications and spam",
   "kind": "complaint",
   "patterns": [
    "\\bnotification",
    "\\bspam",
    "\\btoo many emails\\b",
    "\\bpush\\b",
    "\\breminders?\\b"
   ]
  },
  {
   "id": "ads",
   "label": "Ads",
   "kind": "complaint",
   "patterns": [
    "\\bads\\b",
    "\\badvert",
    "\\bad.?supported\\b",
    "\\bpop.?ups?\\b"
   ]
  },
  {
   "id": "updates",
   "label": "A redesign or update made it worse",
   "kind": "complaint",
   "patterns": [
    "\\b(new|latest|recent) (update|version|design)\\b",
    "\\bredesign",
    "\\bused to be\\b",
    "\\bbring back\\b",
    "\\bsince the update\\b"
   ]
  },
  {
   "id": "privacy",
   "label": "Privacy and permissions",
   "kind": "complaint",
   "patterns": [
    "\\bprivacy\\b",
    "\\btracking\\b",
    "\\bsell(s|ing)? (my )?data\\b",
    "\\bpermissions?\\b",
    "\\bcreepy\\b"
   ]
  },
  {
   "id": "integrations",
   "label": "Integrations, import and export",
   "kind": "request",
   "patterns": [
    "\\bintegrat",
    "\\bzapier\\b",
    "\\bgoogle (calendar|sheets|drive)\\b",
    "\\boutlook\\b",
    "\\bslack\\b",
    "\\bapi\\b",
    "\\bexport\\b",
    "\\bimport\\b",
    "\\bcsv\\b",
    "\\bwebhook"
   ]
  },
  {
   "id": "platforms",
   "label": "Platforms, offline and mobile",
   "kind": "request",
   "patterns": [
    "\\boffline\\b",
    "\\bandroid\\b",
    "\\bipad\\b",
    "\\btablet\\b",
    "\\bdesktop app\\b",
    "\\bmac app\\b",
    "\\bwindows\\b",
    "\\bmobile (app|version)\\b",
    "\\bweb version\\b"
   ]
  },
  {
   "id": "customisation",
   "label": "Customisation and control",
   "kind": "request",
   "patterns": [
    "\\bcustomi[sz]",
    "\\bdark mode\\b",
    "\\btheme\\b",
    "\\bbranding\\b",
    "\\bwhite.?label\\b",
    "\\btemplates?\\b",
    "\\bsettings?\\b",
    "\\boption to\\b"
   ]
  },
  {
   "id": "collaboration",
   "label": "Teams and sharing",
   "kind": "request",
   "patterns": [
    "\\bteam(s|mates?)?\\b",
    "\\bshar(e|ing)\\b",
    "\\bcollaborat",
    "\\bmultiple (users|accounts|people)\\b",
    "\\broles?\\b",
    "\\bpermissions for\\b"
   ]
  }
 ]
}